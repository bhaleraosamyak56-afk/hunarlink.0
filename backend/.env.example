# =============================================================================
# HunarLink FastAPI Backend — Environment Variable Template (.env.example)
# Copy to .env (gitignored) and supply real credentials for local/staging/prod.
# NEVER commit a real .env file or put secrets in React VITE_* variables.
# =============================================================================

APP_ENV=development
APP_NAME=HunarLink API
API_V1_PREFIX=/api/v1
DEBUG=false

# Explicit CORS allowlist (comma-separated origins; NEVER use "*" in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_BASE_URL=http://localhost:5173

# MySQL 8.4 LTS (synchronous SQLAlchemy 2.x + PyMySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hunarlink
MYSQL_USER=hunarlink_app
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
# Optional full URL override (leave blank to use safe URL.create() from MYSQL_* above)
DATABASE_URL=

# Clerk Authentication (identity only; roles & permissions live in MySQL)
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=
# Optional Clerk Backend Secret Key (enables server-side password check & Clerk user cleanup on self-delete)
CLERK_SECRET_KEY=

# Dedicated Admin Email+Password JWT signing secret (generate 32+ random chars)
ADMIN_JWT_SECRET=change_me_to_a_long_random_admin_secret_at_least_32_chars
ADMIN_SESSION_TTL_SECONDS=28800

# Razorpay Standard Checkout (India / INR initial release)
# Keep RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET strictly backend-only!
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_TIMEOUT_SECONDS=15

# Private Seller Document Storage (outside public web root!)
PRIVATE_STORAGE_DIR=./var/private_uploads
MAX_UPLOAD_SIZE_BYTES=5242880
MALWARE_SCANNER_MODE=disabled

# GI Reference Dataset Version
GI_REFERENCE_DATASET_VERSION=unconfigured
